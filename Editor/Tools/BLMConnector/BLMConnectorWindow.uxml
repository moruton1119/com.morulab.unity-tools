<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:ue="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement class="blm-root-container" editor-extension-mode="True">
        <!-- Header (unified: search + filter + sort + view toggle) -->
        <ui:VisualElement class="blm-header">
            <!-- Row 1: Title + Search + Actions -->
            <ui:VisualElement class="blm-header-row">
                <ui:Label text="BLM Connector" class="blm-title" />
                <ui:TextField name="search-field" placeholder-text="Search assets..." class="blm-search-bar" />
                <ui:Button name="grid-view-btn" class="blm-icon-btn blm-icon-btn-active" text="Grid" />
                <ui:Button name="list-view-btn" class="blm-icon-btn" text="List" />
                <ui:Button name="refresh-db" class="blm-icon-btn" text="Refresh" />
                <ui:Button name="open-local-assets-header" class="blm-local-btn" text="Local Assets" />
            </ui:VisualElement>
            <!-- Row 2: Filter chips + Sort -->
            <ui:VisualElement class="blm-header-row">
                <ui:VisualElement name="filter-chips" class="blm-filter-chips" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:DropdownField name="sort-dropdown" class="blm-sort-dropdown" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Content -->
        <ui:VisualElement class="blm-main-content">
            <ui:ScrollView name="asset-scroll-view" class="blm-asset-grid">
                <ui:VisualElement name="grid-container" class="blm-grid-container" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Detail Modal Overlay -->
        <ui:VisualElement name="detail-overlay" class="blm-detail-overlay blm-detail-hidden">
            <ui:VisualElement name="detail-panel" class="blm-detail-modal">
                <ui:VisualElement class="blm-modal-header">
                    <ui:Label name="detail-product-name" text="Product" class="blm-modal-title" />
                    <ui:Button name="close-detail" text="×" class="blm-modal-close-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="blm-modal-path-bar">
                    <ui:Label name="detail-path" text="..." class="blm-modal-path" />
                    <ui:Button name="open-folder" text="📁" class="blm-modal-folder-btn" />
                </ui:VisualElement>
                <ui:ScrollView name="package-list" class="blm-modal-scroll" />
                <ui:VisualElement class="blm-modal-footer">
                    <ui:Button name="add-to-queue" text="Add to Queue" class="blm-import-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Footer with inline Queue -->
        <ui:VisualElement class="blm-footer">
            <ui:VisualElement class="blm-footer-top">
                <ui:Label name="queue-status" text="Queue is empty" class="blm-queue-status" />
                <ui:Toggle name="interactive-toggle" label="Show Import Dialog" value="true" class="blm-footer-toggle" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Button name="view-queue" text="Queue" class="blm-footer-btn" />
                <ui:Button name="reset-queue" text="Clear" class="blm-footer-btn" />
                <ui:Button name="open-local-assets" text="Local" class="blm-footer-btn" />
                <ui:Button name="process-queue" text="Process Queue (0)" class="blm-import-button" />
            </ui:VisualElement>
            <ui:VisualElement name="queue-list-panel" class="blm-queue-expanded blm-detail-hidden">
                <ui:Label text="Import Queue" class="blm-queue-expanded-title" />
                <ui:ScrollView name="queue-list-scroll" class="blm-queue-expanded-scroll" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
