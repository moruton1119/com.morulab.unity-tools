<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:ue="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement class="blm-root-container">
        <!-- Header -->
        <ui:VisualElement class="blm-header">
            <ui:Button name="hamburger-menu" class="blm-hamburger-btn" text="≡" />
            <ui:Label text="Morulab BLM Connector" class="blm-title" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Button name="refresh-db" text="Refresh DB" class="blm-refresh-btn" />
        </ui:VisualElement>

        <!-- Main Content -->
        <ui:VisualElement class="blm-main-content">
            <!-- Sidebar (Toggleable) -->
            <ui:VisualElement name="sidebar" class="blm-sidebar">
                <ui:TextField name="search-field" placeholder-text="Search assets..." class="blm-search-bar" />
                <ui:Label text="FILTER" class="blm-filter-label" />
                <ui:VisualElement name="filter-dropdown-container" class="blm-filter-group" />
                <ui:Button name="open-local-assets" text="📁 Open LocalAssets Folder" class="blm-open-folder-btn" />
            </ui:VisualElement>

            <!-- Center Content (Grid) -->
            <ui:VisualElement class="blm-center-content">
                <ui:ScrollView name="asset-scroll-view" class="blm-asset-grid">
                    <ui:VisualElement name="grid-container" class="blm-grid-container" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Detail Modal Overlay -->
        <ui:VisualElement name="detail-overlay" class="blm-detail-overlay blm-detail-hidden">
            <ui:VisualElement name="detail-panel" class="blm-detail-modal">
                <ui:VisualElement class="blm-modal-header">
                    <ui:Label name="detail-product-name" text="Product" class="blm-modal-title" />
                    <ui:Button name="close-detail" text="×" class="blm-modal-close-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="blm-modal-path-bar">
                    <ui:Label name="detail-path" text="..." class="blm-modal-path" />
                    <ui:Button name="open-folder" text="📁" class="blm-modal-folder-btn" />
                </ui:VisualElement>
                <ui:ScrollView name="package-list" class="blm-modal-scroll" />
                <ui:VisualElement class="blm-modal-footer">
                    <ui:Button name="add-to-queue" text="Add to Queue" class="blm-import-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Queue List Panel (Hidden by default) -->
        <ui:VisualElement name="queue-list-panel" class="blm-queue-panel blm-detail-hidden">
            <ui:Label text="Import Queue" class="blm-queue-panel-title" />
            <ui:ScrollView name="queue-list-scroll" class="blm-queue-panel-scroll" />
            <ui:Button name="close-queue-list" text="Close" class="blm-queue-panel-close" />
        </ui:VisualElement>

        <!-- Footer -->
        <ui:VisualElement class="blm-footer">
            <ui:Label name="queue-status" text="Queue is empty" class="blm-queue-status" />
            <ui:Toggle name="interactive-toggle" label="Show Import Dialog" value="true" class="blm-footer-toggle" />
            <ui:VisualElement class="blm-footer-actions">
                <ui:Button name="view-queue" text="View List" class="blm-footer-btn" />
                <ui:Button name="reset-queue" text="Clear Queue" class="blm-footer-btn" />
                <ui:Button name="process-queue" text="Process Queue (0)" class="blm-import-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
