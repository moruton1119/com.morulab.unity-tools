/* Main container */
.blm-root-container {
    flex-grow: 1;
    background-color: #2b2b2b;
    color: #e0e0e0;
}

/* Header */
.blm-header {
    height: 40px;
    min-height: 40px;
    flex-shrink: 0;
    background-color: #383838;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
}

.blm-title {
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.blm-hamburger-btn {
    width: 32px;
    height: 32px;
    background-color: transparent;
    border-width: 0;
    font-size: 20px;
    color: #e0e0e0;
    cursor: link;
    margin-right: 10px;
}

.blm-hamburger-btn:hover {
    background-color: #454545;
}

/* Tab buttons */
.blm-tab-container {
    flex-direction: row;
    height: 100%;
}

.blm-tab-button {
    padding: 0 15px;
    height: 100%;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
}

.blm-tab-button:hover {
    background-color: #454545;
}

.blm-tab-button-active {
    background-color: #4a4a4a;
    border-bottom-width: 2px;
    border-bottom-color: #007acc;
}

/* Main content */
.blm-main-content {
    flex-grow: 1;
    flex-direction: row;
}

/* Sidebar */
.blm-sidebar {
    width: 200px;
    background-color: #323232;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    padding: 10px;
    transition-property: width;
    transition-duration: 0.2s;
}

.blm-sidebar-hidden {
    width: 0;
    padding: 0;
    border-right-width: 0;
    overflow: hidden;
}

.blm-center-content {
    flex-grow: 1;
    flex-direction: column;
}

.blm-filter-group {
    margin-bottom: 20px;
}

.blm-filter-label {
    font-size: 12px;
    color: #888;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

/* Search Bar */
.blm-search-bar {
    border-radius: 4px;
    background-color: #1e1e1e;
    padding: 4px 8px;
    margin-bottom: 15px;
}

/* Grid View */
.blm-asset-grid {
    flex-grow: 1;
    padding: 10px;
}

.blm-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.blm-grid-item {
    width: 150px;
    margin: 8px;
    background-color: #3c3c3c;
    border-radius: 6px;
    overflow: hidden;
    border-width: 1px;
    border-color: transparent;
}

.blm-grid-item:hover {
    background-color: #4a4a4a;
    border-color: #007acc;
}

.blm-thumbnail-container {
    width: 150px;
    height: 100px;
    background-color: #000;
}

.blm-thumbnail {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.blm-item-info {
    padding: 6px;
}

.blm-item-name {
    font-size: 11px;
    -unity-font-style: bold;
    overflow: hidden;
    -unity-text-wrap: none;
}

.blm-item-shop {
    font-size: 9px;
    color: #aaa;
}

/* Detail Modal Overlay */
.blm-detail-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.6);
    justify-content: center;
    align-items: center;
}

.blm-detail-overlay.blm-detail-hidden {
    display: none;
}

.blm-detail-modal {
    width: 600px;
    max-height: 500px;
    background-color: #2d2d2d;
    border-radius: 8px;
    border-width: 1px;
    border-color: #444;
    padding: 0;
    flex-direction: column;
}

.blm-detail-hidden .blm-detail-modal {
    display: none;
}

.blm-modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #333;
    border-bottom-width: 1px;
    border-bottom-color: #444;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.blm-modal-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #fff;
    flex-grow: 1;
}

.blm-modal-close-btn {
    width: 32px;
    height: 32px;
    font-size: 22px;
    background-color: transparent;
    border-width: 0;
    color: #aaa;
    padding: 0;
}

.blm-modal-close-btn:hover {
    color: #fff;
    background-color: #555;
    border-radius: 4px;
}

.blm-modal-path-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 20px;
    background-color: rgba(0,0,0,0.2);
}

.blm-modal-path {
    flex-grow: 1;
    font-size: 11px;
    color: #888;
}

.blm-modal-folder-btn {
    width: 28px;
    height: 24px;
    font-size: 12px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.blm-modal-folder-btn:hover {
    background-color: #444;
    border-radius: 3px;
}

.blm-modal-scroll {
    flex-grow: 1;
    padding: 10px 20px;
    max-height: 320px;
}

.blm-modal-footer {
    padding: 15px 20px;
    border-top-width: 1px;
    border-top-color: #444;
    flex-direction: row;
    justify-content: flex-end;
    background-color: #282828;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.blm-package-list-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: #444;
}

/* Footer (Queue) */
.blm-footer {
    min-height: 60px;
    height: auto;
    flex-shrink: 0;
    flex-wrap: wrap;
    background-color: #252525;
    border-top-width: 1px;
    border-top-color: #1a1a1a;
    flex-direction: row;
    align-items: center;
    padding: 8px 15px;
}

.blm-footer Button {
    min-height: 24px;
    min-width: 80px;
}

.blm-queue-status {
    flex-grow: 1;
    font-size: 11px;
    color: #007acc;
}

.blm-import-button {
    background-color: #007acc;
    color: white;
    padding: 4px 15px;
    border-radius: 3px;
    -unity-font-style: bold;
}

.blm-import-button:hover {
    background-color: #008be5;
}

.blm-installed {
    opacity: 0.5;
    -unity-background-image-tint-color: #888888;
}

.blm-installed:hover {
    opacity: 0.8;
}

.blm-batch-imported {
    border-color: #4a9eff;
    border-width: 2px;
    background-color: rgba(74, 158, 255, 0.1);
}

/* Refresh Button */
.blm-refresh-btn {
    margin-left: 8px;
    padding: 4px 12px;
}

/* Open Folder Button (sidebar) */
.blm-open-folder-btn {
    margin-top: 10px;
    font-size: 12px;
    white-space: normal;
}

/* Queue Panel (floating) */
.blm-queue-panel {
    position: absolute;
    bottom: 60px;
    right: 10px;
    width: 300px;
    height: 200px;
    background-color: #2a2a2a;
    border-width: 1px;
    border-color: #444;
    border-radius: 5px;
    padding: 5px;
}

.blm-queue-panel-title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    color: #e0e0e0;
}

.blm-queue-panel-scroll {
    flex-grow: 1;
}

.blm-queue-panel-close {
    height: 20px;
    margin-top: 5px;
}

/* Footer Toggle */
.blm-footer-toggle {
    margin-bottom: 5px;
}

/* Footer Action Buttons */
.blm-footer-actions {
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
}

.blm-footer-btn {
    margin-right: 5px;
}

.blm-footer-btn:hover {
    background-color: #454545;
}
