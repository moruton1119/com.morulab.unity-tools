/* Main container */
.blm-root-container {
    flex-grow: 1;
    background-color: #2b2b2b;
    color: #e0e0e0;
}

/* Header */
.blm-header {
    background-color: #383838;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    flex-shrink: 0;
    padding: 8px 12px;
}

.blm-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.blm-header-row:last-child {
    margin-bottom: 0;
}

.blm-title {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: nowrap;
    margin-right: 10px;
    flex-shrink: 0;
}

.blm-search-bar {
    flex-grow: 1;
    background-color: #1e1e1e;
    border-width: 1px;
    border-color: #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #ccc;
    font-size: 12px;
    margin-right: 6px;
}

.blm-search-bar:focus {
    border-color: #007acc;
}

.blm-icon-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #555;
    border-radius: 4px;
    color: #ccc;
    padding: 4px 8px;
    font-size: 14px;
    margin-right: 4px;
    flex-shrink: 0;
}

.blm-icon-btn:hover {
    background-color: #454545;
}

.blm-icon-btn-active {
    background-color: #007acc;
    border-color: #007acc;
    color: #fff;
}

/* Filter chips */
.blm-filter-chips {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
}

.blm-chip {
    background-color: #3c3c3c;
    border-width: 1px;
    border-color: #555;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    color: #aaa;
}

.blm-chip:hover {
    background-color: #4a4a4a;
}

.blm-chip-active {
    background-color: #007acc;
    border-color: #007acc;
    color: #fff;
}

/* Sort dropdown */
.blm-sort-dropdown {
    width: 140px;
    font-size: 11px;
    flex-shrink: 0;
}

/* Main content */
.blm-main-content {
    flex-grow: 1;
    flex-direction: column;
}

/* Grid View */
.blm-asset-grid {
    flex-grow: 1;
    padding: 8px;
}

.blm-asset-grid > * {
    width: 100%;
}

.blm-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    width: 100%;
}

.blm-grid-item {
    width: 160px;
    margin: 6px;
    background-color: #3c3c3c;
    border-radius: 6px;
    overflow: hidden;
    border-width: 1px;
    border-color: transparent;
    flex-shrink: 0;
}

.blm-grid-item:hover {
    background-color: #4a4a4a;
    border-color: #007acc;
}

.blm-thumbnail-container {
    width: 160px;
    height: 110px;
    background-color: #000;
}

.blm-thumbnail {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.blm-item-info {
    padding: 6px;
}

.blm-item-name {
    font-size: 11px;
    -unity-font-style: bold;
    overflow: hidden;
    -unity-text-wrap: none;
}

.blm-item-shop {
    font-size: 9px;
    color: #aaa;
}

/* List View */
.blm-list-container {
    flex-direction: column;
    width: 100%;
}

.blm-list-item {
    flex-direction: row;
    align-items: center;
    background-color: #3c3c3c;
    border-radius: 4px;
    padding: 6px 10px;
    margin-bottom: 3px;
    border-width: 1px;
    border-color: transparent;
}

.blm-list-item:hover {
    border-color: #007acc;
    background-color: #4a4a4a;
}

.blm-list-thumb {
    width: 40px;
    height: 40px;
    background-color: #000;
    border-radius: 3px;
    margin-right: 8px;
    flex-shrink: 0;
}

.blm-list-info {
    flex-grow: 1;
}

.blm-list-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: #e0e0e0;
}

.blm-list-shop {
    font-size: 10px;
    color: #aaa;
}

.blm-list-meta {
    font-size: 9px;
    color: #666;
    flex-shrink: 0;
    margin-left: 8px;
}

/* Detail Modal */
.blm-detail-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.6);
    justify-content: center;
    align-items: center;
}

.blm-detail-overlay.blm-detail-hidden {
    display: none;
}

.blm-detail-modal {
    width: 600px;
    max-height: 500px;
    background-color: #2d2d2d;
    border-radius: 8px;
    border-width: 1px;
    border-color: #444;
    flex-direction: column;
}

.blm-detail-hidden .blm-detail-modal {
    display: none;
}

.blm-modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #333;
    border-bottom-width: 1px;
    border-bottom-color: #444;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.blm-modal-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #fff;
    flex-grow: 1;
}

.blm-modal-close-btn {
    width: 32px;
    height: 32px;
    font-size: 22px;
    background-color: transparent;
    border-width: 0;
    color: #aaa;
    padding: 0;
}

.blm-modal-close-btn:hover {
    color: #fff;
    background-color: #555;
    border-radius: 4px;
}

.blm-modal-path-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 20px;
    background-color: rgba(0,0,0,0.2);
}

.blm-modal-path {
    flex-grow: 1;
    font-size: 11px;
    color: #888;
}

.blm-modal-folder-btn {
    width: 28px;
    height: 24px;
    font-size: 12px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.blm-modal-folder-btn:hover {
    background-color: #444;
    border-radius: 3px;
}

.blm-modal-scroll {
    flex-grow: 1;
    padding: 10px 20px;
    max-height: 320px;
}

.blm-modal-footer {
    padding: 15px 20px;
    border-top-width: 1px;
    border-top-color: #444;
    flex-direction: row;
    justify-content: flex-end;
    background-color: #282828;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.blm-package-list-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: #444;
}

/* Footer */
.blm-footer {
    flex-shrink: 0;
    background-color: #252525;
    border-top-width: 1px;
    border-top-color: #1a1a1a;
    flex-direction: column;
    padding: 8px 12px;
    min-height: 38px;
}

.blm-footer-top {
    flex-direction: row;
    align-items: center;
}

.blm-footer-toggle {
    flex-shrink: 0;
    margin-left: 10px;
}

.blm-footer-btn {
    margin-right: 6px;
}

.blm-footer-btn:hover {
    background-color: #454545;
}

.blm-queue-status {
    flex-grow: 1;
    font-size: 11px;
    color: #007acc;
}

/* Queue expanded (inline in footer) */
.blm-queue-expanded {
    background-color: #1e1e1e;
    border-top-width: 1px;
    border-top-color: #333;
    padding: 8px 0;
    margin-top: 6px;
    max-height: 140px;
}

.blm-queue-expanded.blm-detail-hidden {
    display: none;
}

.blm-queue-expanded-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ccc;
    margin-bottom: 4px;
    padding-left: 0;
}

.blm-queue-expanded-scroll {
    max-height: 100px;
}

/* Common */
.blm-import-button {
    background-color: #007acc;
    color: white;
    padding: 4px 15px;
    border-radius: 3px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.blm-import-button:hover {
    background-color: #008be5;
}

.blm-installed {
    opacity: 0.5;
    -unity-background-image-tint-color: #888888;
}

.blm-installed:hover {
    opacity: 0.8;
}

.blm-batch-imported {
    border-color: #4a9eff;
    border-width: 2px;
    background-color: rgba(74, 158, 255, 0.1);
}

.blm-refresh-btn {
    margin-left: 8px;
    padding: 4px 12px;
}
